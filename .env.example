# Backend
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# AI Advisor (optional — leave blank for rule-based fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Bank Provider: "mock" or "setu"
BANK_PROVIDER=mock

# Setu AA Sandbox (only needed if BANK_PROVIDER=setu)
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co

# OCR (optional — falls back to Tesseract.js on client)
OCR_API_KEY=

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=Paise Bachao

